// Canonical schema — edit models here, then mirror into
// packages/db/prisma/schema.prisma and run: npm run db:generate
// (Client is generated from packages/db; do not output into root src/.)

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Role {
  CEO
  CLINICAL_DIRECTOR
  OPS_DIRECTOR
  INTAKE_PA_COORDINATOR
  CASE_COORDINATOR
  SESSION_NOTES_COORDINATOR
  CLINICAL_SUPPORT
  BILLING
  BCBA
  RBT
  HR
  HEAD_HR
  HR_AGENT
  FINANCE
}

enum ClientStatus {
  INQUIRY
  MAGIC_LINK_SENT
  DOCS_SUBMITTED
  DOCS_APPROVED_INTAKE
  CLINICAL_REVIEW_APPROVED
  VOB_COMPLETED
  PA_SUBMITTED
  PA_APPROVED
  ASSESSMENT_SCHEDULED
  REPORT_ASSEMBLED
  TX_PA_SUBMITTED
  TX_PA_APPROVED
  STAFFING_PENDING
  ACTIVE
  DISCHARGED
}

/// Artemis dual-run cohort mode — per-client pilot tracking (Phase 1).
enum DualRunMode {
  D0_SHADOW
  D1_DUAL_WRITE
  D2_RAS_PRIMARY
}

enum IntakePacketStatus {
  PENDING_CLIENT_SUBMISSION
  SUBMITTED
  REJECTED_BY_INTAKE
  REJECTED_BY_CLINICAL
  APPROVED
}

enum PARequestStatus {
  NOT_STARTED
  SUBMITTED
  DENIED_CLERICAL
  DENIED_CLINICAL
  APPROVED
}

enum ClaimOutcome {
  APPROVED
  DENIED_CLERICAL
  DENIED_CLINICAL
}

enum DocumentType {
  REFERRAL
  DIAGNOSTIC_EVAL
  PSYCH_EVAL
  IEP
  INSURANCE_CARD
  MEDICAID_CARD
  CONSENT
  CUSTODY
  PRIOR_TREATMENT_PLAN
  MEET_AND_GREET_FORM
  OTHER
}

enum AuthType {
  ASSESSMENT
  TREATMENT
}

enum AuthStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ContactMethod {
  PHONE
  EMAIL
  IN_PERSON
  VIDEO
  PORTAL
}

enum DeficiencyStatus {
  OPEN
  RESOLVED
}

enum JurisdictionLevel {
  COUNTRY
  STATE
  LOCAL
}

enum ProviderEnrollmentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum RuleAuthorityKind {
  FEDERAL
  JURISDICTION
  PAYER_PLAN
  SERVICE_LOCATION
  ORGANIZATION
}

enum RuleLifecycleStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  RETIRED
}

enum RuleCategory {
  BILLING
  EVV
  CREDENTIAL
  CONSENT
  RETENTION
  INCIDENT
  EMPLOYMENT
}

// ------------------------------------------------------
// MODELS
// ------------------------------------------------------

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  firstName String
  lastName  String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organizationId String? @db.Uuid

  // Relationships
  assignedCases          Client[]         @relation("CaseCoordinator")
  supportedClients       Client[]         @relation("ClinicalSupport")
  supervisedClients      Client[]         @relation("BCBASupervisor")
  clientsAsRbt           Client[]         @relation("RBT")
  sessionsAsRbt          Session[]        @relation("RbtSession")
  sessionsAsBcba         Session[]        @relation("BcbaSession")
  assignedActionItems    ActionItem[]     @relation("Assignee")
  createdActionItems     ActionItem[]     @relation("Creator")
  contactLogs            ContactLog[]
  rbtOnboardings         RbtOnboarding[]
  deficienciesToFix      NoteDeficiency[] @relation("DeficiencyAuthor")
  deficienciesFlagged    NoteDeficiency[] @relation("DeficiencyFlagger")
  sentMessages           StaffMessage[]   @relation("StaffMessageSender")
  receivedMessages       StaffMessage[]   @relation("StaffMessageReceiver")
  notifications          Notification[]
  credentials            StaffCredential[]
  evvLogs                EVVLog[]
  atsCandidatesAsStaff   AtsCandidate[]   @relation("AtsCandidateUser")
  atsCandidatesAssigned  AtsCandidate[]   @relation("AtsAssignedHrAgent")
  atsInterviewsAsInterviewer AtsInterview[] @relation("AtsInterviewInterviewer")
  atsInterviewsClaimed       AtsInterview[] @relation("AtsInterviewClaimedBy")
  atsHelpTicketsClaimed      AtsHelpTicket[] @relation("AtsHelpTicketClaimedBy")
  atsHelpMessagesSent        AtsHelpMessage[] @relation("AtsHelpMessageSender")
  atsInterviewRecordings     AtsInterviewRecording[] @relation("AtsInterviewRecordingCreator")
  caseOpeningsCreated        CaseOpening[]           @relation("CaseOpeningCreator")
  caseApplications           CaseApplication[]       @relation("CaseApplicationRbt")
  organization               Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  providerEnrollments        ProviderEnrollment[]
  approvedRuleVersions       RuleVersion[]            @relation("RuleVersionApprover")

  @@index([organizationId])
}

model Client {
  id              String       @id @default(uuid()) @db.Uuid
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  childGender     String?
  childAge        Int?
  
  insurancePayer  String?
  memberId        String?
  medicaidId      String?
  status          ClientStatus @default(INQUIRY)
  
  // Contacts & Guardians
  guardianName            String?
  parentGender            String?
  parentAddress           String?
  guardianPhone           String?
  guardianEmail           String?
  secondaryGuardianName   String?
  secondaryGuardianPhone  String?
  secondaryGuardianEmail  String?

  // Clinical EMR Diagnosis & Chart
  primaryDiagnosisCode    String?
  secondaryDiagnosisCode  String?

  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  organizationId          String?      @db.Uuid
  primaryServiceLocationId String?     @db.Uuid

  // Clinical & Ops Team
  caseCoordinatorId String?    @db.Uuid
  clinicalSupportId String?    @db.Uuid
  bcbaId            String?    @db.Uuid
  rbtId             String?    @db.Uuid
  rbtApproved       Boolean    @default(false)

  /// Ops-assigned dual-run pilot cohort label (e.g. "pilot-week1-2026").
  dualRunCohort     String?
  dualRunMode       DualRunMode?

  caseCoordinator   User?      @relation("CaseCoordinator", fields: [caseCoordinatorId], references: [id])
  clinicalSupport   User?      @relation("ClinicalSupport", fields: [clinicalSupportId], references: [id])
  bcba              User?      @relation("BCBASupervisor", fields: [bcbaId], references: [id])
  rbt               User?      @relation("RBT", fields: [rbtId], references: [id])

  // Relations
  documents       Document[]
  authorizations  Authorization[]
  sessions        Session[]
  contactLogs     ContactLog[]
  rbtOnboarding   RbtOnboarding?
  
  intakePacket    IntakePacket?
  paRequests      PARequest[]
  messages        ClientMessage[]
  actionItems     ActionItem[]
  treatmentPlan   Json?        @default("{}")

  skillTargets    SkillTarget[]
  behaviorTargets BehaviorTarget[]
  appointments    ScheduleAppointment[]
  reAuthPackets   ReAuthPacket[]
  caseOpenings    CaseOpening[]
  notifications   Notification[]
  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  primaryServiceLocation ServiceLocation? @relation(fields: [primaryServiceLocationId], references: [id], onDelete: Restrict)

  @@index([caseCoordinatorId])
  @@index([clinicalSupportId])
  @@index([bcbaId])
  @@index([rbtId])
  @@index([dualRunCohort])
  @@index([organizationId])
  @@index([primaryServiceLocationId])
}

model Document {
  id             String       @id @default(uuid()) @db.Uuid
  clientId       String       @db.Uuid
  type           DocumentType
  fileUrl        String?
  expirationDate DateTime?
  isVerified     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model Authorization {
  id             String       @id @default(uuid()) @db.Uuid
  clientId       String       @db.Uuid
  type           AuthType
  status         AuthStatus   @default(PENDING)
  authNumber     String?
  startDate      DateTime?
  endDate        DateTime?
  unitsRequested Int?
  unitsApproved  Int?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  cptCodes       AuthCptCode[]

  @@index([clientId, createdAt])
}

model AuthCptCode {
  id              String        @id @default(uuid()) @db.Uuid
  authorizationId String        @db.Uuid
  code            String        // e.g. 97151, 97153
  unitsApproved   Int?

  authorization   Authorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)

  @@index([authorizationId])
}

model Session {
  id              String        @id @default(uuid()) @db.Uuid
  clientId        String        @db.Uuid
  rbtId           String?       @db.Uuid
  bcbaId          String?       @db.Uuid
  
  status          SessionStatus @default(SCHEDULED)
  scheduledStart  DateTime
  scheduledEnd    DateTime
  actualStart     DateTime?
  actualEnd       DateTime?
  
  cptCode             String?       // e.g. 97153
  location            String?
  placeOfServiceCode  String?       // CMS POS code e.g. "12"

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organizationId  String?       @db.Uuid
  serviceLocationId String?     @db.Uuid

  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  rbt             User?         @relation("RbtSession", fields: [rbtId], references: [id])
  bcba            User?         @relation("BcbaSession", fields: [bcbaId], references: [id])
  note            SessionNote?
  trialLogs       SessionTrialData[]
  behaviorLogs    BehaviorLog[]
  evvLogs         EVVLog[]
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceLocation ServiceLocation? @relation(fields: [serviceLocationId], references: [id], onDelete: Restrict)
  resolvedRuleSnapshots ResolvedRuleSnapshot[]

  // Hot paths: client-scoped lists/ranges ordered by scheduledStart (chart,
  // notes pipeline, auth units, weekly grids, parent portal, activation gate)
  // and RBT schedule/payroll windows. Equality-only filters (e.g. rbtId+status)
  // are served by the leading column of each index.
  @@index([clientId, scheduledStart])
  @@index([rbtId, scheduledStart])
  @@index([bcbaId, scheduledStart])
  @@index([organizationId, scheduledStart])
  @@index([serviceLocationId, scheduledStart])
}

model SessionNote {
  id              String    @id @default(uuid()) @db.Uuid
  sessionId       String    @unique @db.Uuid

  rbtSigned       Boolean   @default(false)
  parentSigned    Boolean   @default(false)
  bcbaSigned      Boolean   @default(false)

  clinicalContent    String?   @db.Text
  structuredContent  Json?     // SoT header + sections + modality snapshot
  checklistSnapshot  Json?     // billing checklist freeze at RBT submit
  billableUnits      Int?

  rbtSignedAt        DateTime?
  parentSignedAt     DateTime?
  bcbaSignedAt       DateTime?
  rbtSignerName      String?
  parentSignerName   String?
  bcbaSignerName     String?

  plutusClaimRef     String?   // manual Plutus tracker claim / batch id
  convertedAt        DateTime?
  isConverted        Boolean   @default(false) // Billable status — CRM /notes only
  claimOutcome       ClaimOutcome? // payer adjudication after isConverted

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  session         Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  deficiencies    NoteDeficiency[]

  @@index([bcbaSigned, isConverted])
  @@index([rbtSigned, bcbaSigned])
}

model ActionItem {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String?      @db.Text
  status      ActionStatus @default(OPEN)
  dueDate     DateTime?

  assigneeId  String?      @db.Uuid
  creatorId   String?      @db.Uuid
  clientId    String?      @db.Uuid

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assignee    User?        @relation("Assignee", fields: [assigneeId], references: [id])
  creator     User?        @relation("Creator", fields: [creatorId], references: [id])
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([assigneeId, createdAt])
  @@index([creatorId])
  @@index([clientId])
}

model ContactLog {
  id          String        @id @default(uuid()) @db.Uuid
  clientId    String        @db.Uuid
  authorId    String        @db.Uuid
  method      ContactMethod
  subject     String
  outcome     String        @db.Text
  nextStep    String?       @db.Text
  
  createdAt   DateTime      @default(now())

  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author      User          @relation(fields: [authorId], references: [id])

  @@index([clientId, createdAt])
  @@index([authorId])
}

model RbtOnboarding {
  id                  String   @id @default(uuid()) @db.Uuid
  clientId            String   @unique @db.Uuid
  rbtId               String   @db.Uuid

  bacbVerified        Boolean  @default(false)
  backgroundCleared   Boolean  @default(false)
  trainingsComplete   Boolean  @default(false)
  clinicalEmrProvisioned Boolean  @default(false)
  payrollComplete     Boolean  @default(false)
  payerCredentialed   Boolean  @default(false)
  planOrientationDate DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  rbt                 User     @relation(fields: [rbtId], references: [id])

  @@index([rbtId])
}

model NoteDeficiency {
  id          String           @id @default(uuid()) @db.Uuid
  noteId      String           @db.Uuid
  authorId    String           @db.Uuid
  flaggedById String           @db.Uuid
  
  description String           @db.Text
  status      DeficiencyStatus @default(OPEN)

  createdAt   DateTime         @default(now())
  resolvedAt  DateTime?

  note        SessionNote      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author      User             @relation("DeficiencyAuthor", fields: [authorId], references: [id])
  flaggedBy   User             @relation("DeficiencyFlagger", fields: [flaggedById], references: [id])

  @@index([noteId, status])
  @@index([authorId])
  @@index([flaggedById])
}

model IntakePacket {
  id              String             @id @default(uuid()) @db.Uuid
  clientId        String             @unique @db.Uuid
  magicLinkToken  String?            @unique
  magicLinkExpiresAt DateTime?
  magicLinkRevokedAt DateTime?
  deviceFingerprint String?
  status          IntakePacketStatus @default(PENDING_CLIENT_SUBMISSION)
  
  // Form checks
  intakeFormComplete      Boolean @default(false)
  consentFormComplete     Boolean @default(false)
  
  // JSON blob for continuous scrolling form
  formData                Json?   @default("{}")
  
  // Document uploads
  insuranceCardFrontUploaded Boolean @default(false)
  insuranceCardBackUploaded  Boolean @default(false)
  medicaidCardFrontUploaded  Boolean @default(false)
  medicaidCardBackUploaded   Boolean @default(false)
  diagnosticEvalUploaded  Boolean @default(false)
  physicianRxUploaded     Boolean @default(false)
  iepUploaded             Boolean @default(false)
  custodyDocsUploaded     Boolean @default(false)
  priorAbaRecordsUploaded Boolean @default(false)

  rejectionNotes  String? @db.Text
  rejectionDetails Json?  @default("{}")

  // Client requests
  clientChangeRequested Boolean @default(false)
  clientChangeNotes     String? @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model PARequest {
  id                    String          @id @default(uuid()) @db.Uuid
  clientId              String          @db.Uuid
  type                  AuthType
  status                PARequestStatus @default(NOT_STARTED)
  
  vobCompleted          Boolean @default(false)
  providerCredentialed  Boolean @default(false)

  // Final Auth Info
  authNumber            String?
  approvedUnits         Int?
  effectiveDate         DateTime?
  expirationDate        DateTime?
  
  p2pResolved           Boolean  @default(false)
  p2pNotes              String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  client                Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model ClientMessage {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @db.Uuid
  content     String   @db.Text
  isFromClient Boolean @default(false)
  senderName  String
  createdAt   DateTime @default(now())
  readAt      DateTime?

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model StaffMessage {
  id          String   @id @default(uuid()) @db.Uuid
  senderId    String   @db.Uuid
  receiverId  String   @db.Uuid
  content     String   @db.Text
  createdAt   DateTime @default(now())
  readAt      DateTime?

  sender      User     @relation("StaffMessageSender", fields: [senderId], references: [id])
  receiver    User     @relation("StaffMessageReceiver", fields: [receiverId], references: [id])
}

model GoalTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   // "SKILL", "BRP", "PARENT"
  
  // Skill & Parent Fields
  domain      String?
  description String?
  mastery     String?

  // BRP Specific Fields
  behavior    String?
  topography  String?
  function    String?
  antecedent  String?
  consequence String?

  authorName  String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  clientId  String?  @db.Uuid
  title     String
  message   String   @db.Text
  type      String   @default("INFO") // INFO, WARNING, ALERT
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, isRead])
  @@index([userId, isRead])
}

// ------------------------------------------------------
// IN-HOUSE EMR & DATA COLLECTION MODELS (MOTIVITY REPLACEMENT)
// ------------------------------------------------------

model SkillTarget {
  id              String   @id @default(uuid()) @db.Uuid
  clientId        String   @db.Uuid
  domain          String   // e.g. "Language", "Social", "Self-Help"
  title           String
  description     String?  @db.Text
  measurementType String   @default("TRIAL") // TRIAL, FREQUENCY, DURATION, TASK_ANALYSIS, INTERVAL
  targetStatus    String   @default("BASELINE") // BASELINE, IN_PROGRESS, MASTERED, ON_HOLD
  masteryCriteria String?  @default("80% over 3 sessions")
  baselineData    Float?
  phaseLines      Json?    @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trialLogs       SessionTrialData[]
}

model SessionTrialData {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @db.Uuid
  targetId    String   @db.Uuid
  score       String   // "+", "-", "P", "NR", or numeric duration/count
  promptLevel String?  // Independent, Verbal, Gestural, Model, Partial Physical, Full Physical
  trialIndex  Int      @default(1)
  timestamp   DateTime @default(now())

  session     Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  target      SkillTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
}

model BehaviorTarget {
  id                  String   @id @default(uuid()) @db.Uuid
  clientId            String   @db.Uuid
  behaviorName        String
  definition          String   @db.Text
  measurementType     String   @default("FREQUENCY") // FREQUENCY, DURATION, RATE
  antecedents         String?  @db.Text
  consequences        String?  @db.Text
  replacementBehavior String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client              Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  behaviorLogs        BehaviorLog[]
}

model BehaviorLog {
  id             String         @id @default(uuid()) @db.Uuid
  sessionId      String         @db.Uuid
  behaviorId     String         @db.Uuid
  frequencyCount Int?           @default(1)
  durationSeconds Int?          @default(0)
  intensity      String?        @default("MODERATE") // MILD, MODERATE, SEVERE
  abcNotes       String?        @db.Text
  timestamp      DateTime       @default(now())

  session        Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  behavior       BehaviorTarget @relation(fields: [behaviorId], references: [id], onDelete: Cascade)

  @@index([behaviorId])
}

// ------------------------------------------------------
// IN-HOUSE HRM & EVV MODELS (ARTEMIS HRM REPLACEMENT)
// ------------------------------------------------------

model StaffCredential {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  credentialType   String    // e.g. "NPI", "CAQH", "BACB_LICENSE", "CPR_CERT", "MEDICAID_PROVIDER_ID"
  credentialNumber String?
  payerName        String?   @default("ALL_PAYERS") // e.g. "Sunshine Health", "Simply Healthcare", "ALL_PAYERS"
  isCredentialed   Boolean   @default(true)
  expirationDate   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EVVLog {
  id                 String    @id @default(uuid()) @db.Uuid
  sessionId          String    @db.Uuid
  staffId            String    @db.Uuid
  clockInLat         Float?
  clockInLng         Float?
  clockOutLat        Float?
  clockOutLng        Float?
  isLocationVerified Boolean   @default(true)
  clockInTimestamp   DateTime  @default(now())
  clockOutTimestamp  DateTime?

  // State EVV Aggregator Sync (Cures Act Direct Integration)
  aggregatorVendor       String?   // HHAEXCHANGE | SANDATA | TELLUS
  aggregatorStatus       String?   @default("PENDING") // PENDING | SUBMITTED | ACCEPTED | REJECTED
  aggregatorResponseId   String?
  aggregatorSubmittedAt DateTime?

  session            Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staff              User      @relation(fields: [staffId], references: [id], onDelete: Cascade)
}


// ------------------------------------------------------
// INTELLIGENT SCHEDULING MODELS (PHASE 5)
// ------------------------------------------------------

model ScheduleAppointment {
  id             String   @id @default(uuid()) @db.Uuid
  clientId       String   @db.Uuid
  rbtId          String?  @db.Uuid
  bcbaId         String?  @db.Uuid
  scheduledStart DateTime
  scheduledEnd   DateTime
  serviceAddress String?
  cptCode        String   @default("97153")
  status         String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, NO_SHOW
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// RE-AUTH & AUDIT VAULT MODELS (PHASES 9 & 11)
// ------------------------------------------------------

model ReAuthPacket {
  id                   String   @id @default(uuid()) @db.Uuid
  clientId             String   @db.Uuid
  paRequestId          String?  @db.Uuid
  status               String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, DENIED
  skillGraphSummary    Json?    @default("{}")
  behaviorGraphSummary Json?    @default("{}")
  attendancePct        Float    @default(95.0)
  cptRequestPayload    Json?    @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  client               Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([paRequestId])
}

model AuditLogVault {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  action       String   // VIEW, EDIT, SIGN, EXPORT, DELETE
  resourceType String   // CLIENT, SESSION_NOTE, PA_REQUEST, BILLING_CLAIM
  resourceId   String
  ipAddress    String?
  metadata     Json?    @default("{}")
  timestamp    DateTime @default(now())
}

// ------------------------------------------------------
// ATS RECRUITING & ONBOARDING MODELS (PHASE 13)
// ------------------------------------------------------

model AtsCandidate {
  id               String   @id @default(uuid()) @db.Uuid
  firstName        String
  lastName         String
  email            String   @unique
  phone            String?
  appliedRole      String   @default("RBT") // RBT, BCBA, CLINICAL_DIRECTOR
  stage            String   @default("APPLIED") // APPLIED, PHONE_SCREEN, INTERVIEW, OFFER, HIRED, HELP_DESK, REJECTED
  activationStatus String   @default("PENDING_HR_REVIEW") // PENDING_HR_REVIEW, INVITATION_SENT, ACTIVE, REJECTED
  bacbNumber       String?
  bacbVerified     Boolean  @default(false)
  dossier          Json?    @default("{}")
  userId           String?  @db.Uuid
  assignedHrAgentId String? @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user               User?                       @relation("AtsCandidateUser", fields: [userId], references: [id], onDelete: SetNull)
  assignedHrAgent    User?                       @relation("AtsAssignedHrAgent", fields: [assignedHrAgentId], references: [id], onDelete: SetNull)
  onboardingPacket   CandidateOnboardingPacket?
  interview          AtsInterview?
  helpTickets        AtsHelpTicket[]
  interviewRecordings AtsInterviewRecording[]
  deviceSessions     ApplicantDeviceSession[]
  signatureEvents    OnboardingSignatureEvent[]
}

model CandidateOnboardingPacket {
  id                    String   @id @default(uuid()) @db.Uuid
  candidateId           String   @unique @db.Uuid
  magicLinkToken        String?  @unique
  magicLinkExpiresAt    DateTime?
  magicLinkRevokedAt    DateTime?
  w4Complete            Boolean  @default(false)
  i9Complete            Boolean  @default(false)
  directDepositComplete Boolean  @default(false)
  cprUploaded           Boolean  @default(false)
  formData              Json?    @default("{}")

  // Phase 1: durable requirement progress (replaces ras_rbt_* localStorage)
  tasksDone             Boolean  @default(false)
  tasksCompletedSteps   Json     @default("[]")
  availabilityDone      Boolean  @default(false)
  availabilityGrid      Json     @default("[]")
  preferredBoroughs     Json     @default("[]")
  transportation        String?
  homeZipCode           String?
  maxTravelMiles        Int?     @default(15)
  simulationDone        Boolean  @default(false)
  interviewBooked       Boolean  @default(false)
  interviewPassed       Boolean  @default(false)
  certUploaded          Boolean  @default(false)
  backgroundCleared     Boolean  @default(false)
  clearedForHire        Boolean  @default(false)

  // Phase 5: application documents in Storage (paths, not blobs)
  resumeFileName        String?
  resumeStoragePath     String?
  govtIdFileName        String?
  govtIdStoragePath     String?

  // Phase 6: device-bound magic-link login
  deviceFingerprint     String?
  deviceBoundAt         DateTime?
  inviteSentAt          DateTime?
  inviteAcceptedAt      DateTime?

  ls54PreparedAt        DateTime?
  ls54PreparedByUserId  String?  @db.Uuid
  ls54StoragePath       String?
  ls54Payload           Json?
  ls54Status            String   @default("NONE") // NONE | DRAFT | SENT | IN_DISCUSSION | SIGNED | DECLINED
  ls54Version           Int      @default(0)
  ls54SentAt            DateTime?
  ls54SignedAt          DateTime?
  ls54DeclinedAt        DateTime?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  candidate             AtsCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model AtsInterview {
  id                 String    @id @default(uuid()) @db.Uuid
  candidateId        String    @unique @db.Uuid
  interviewerUserId  String?   @db.Uuid
  claimedByUserId    String?   @db.Uuid
  scheduledDate      String?
  scheduledTime      String?
  scheduledAt        DateTime?
  meetingCode        String?
  meetingLink        String?
  status             String    @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED | NO_SHOW
  hrJoinedAt         DateTime?
  scorecard          Json      @default("{}")
  interviewerNotes   String?
  scriptProgress     Json      @default("{}")
  recommendation     String?   // ADVANCE | REJECT | HOLD
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  candidate          AtsCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewer        User?        @relation("AtsInterviewInterviewer", fields: [interviewerUserId], references: [id], onDelete: SetNull)
  claimedBy          User?        @relation("AtsInterviewClaimedBy", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  recordings         AtsInterviewRecording[]

  @@index([status])
  @@index([interviewerUserId])
  @@index([claimedByUserId])
  @@index([scheduledAt])
}

model AtsHelpTicket {
  id              String    @id @default(uuid()) @db.Uuid
  candidateId     String    @db.Uuid
  claimedByUserId String?   @db.Uuid
  subject         String    @default("Candidate Help Request")
  status          String    @default("OPEN") // OPEN | CLAIMED | RESOLVED | CLOSED
  priority        String    @default("NORMAL")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  resolvedAt      DateTime?

  candidate       AtsCandidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  claimedBy       User?           @relation("AtsHelpTicketClaimedBy", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  messages        AtsHelpMessage[]

  @@index([candidateId])
  @@index([status])
  @@index([claimedByUserId])
}

model AtsHelpMessage {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @db.Uuid
  senderType   String   // CANDIDATE | HR_AGENT | HEAD_HR | SYSTEM
  senderUserId String?  @db.Uuid
  body         String
  createdAt    DateTime @default(now())

  ticket       AtsHelpTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUser   User?         @relation("AtsHelpMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([createdAt])
  @@index([senderUserId])
}

model AtsInterviewRecording {
  id               String   @id @default(uuid()) @db.Uuid
  interviewId      String   @db.Uuid
  candidateId      String   @db.Uuid
  title            String   @default("Interview Take")
  storageBucket    String   @default("ats-interview-recordings")
  storagePath      String
  mimeType         String   @default("video/webm")
  durationSeconds  Int      @default(0)
  byteSize         BigInt?
  createdByUserId  String?  @db.Uuid
  createdAt        DateTime @default(now())

  interview        AtsInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  candidate        AtsCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdBy        User?        @relation("AtsInterviewRecordingCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([interviewId])
  @@index([candidateId])
  @@index([createdByUserId])
}

model ApplicantDeviceSession {
  id                String    @id @default(uuid()) @db.Uuid
  candidateId       String    @db.Uuid
  deviceFingerprint String
  magicLinkToken    String
  userAgent         String?
  ipAddress         String?
  boundAt           DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  revokedAt         DateTime?

  candidate         AtsCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, deviceFingerprint])
  @@index([magicLinkToken])
  @@index([candidateId])
}

model OnboardingSignatureEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  candidateId        String   @db.Uuid
  stepNumber         Int
  documentKey        String
  documentTitle      String
  documentVersion    String
  actionType         String
  signerName         String?
  consents           Json     @default("{}")
  auditHash          String
  storagePath        String?
  fileName           String?
  quizScore          Int?
  quizAttempt        Int?
  quizAnswers        Json?
  ipAddress          String?
  userAgent          String?
  deviceFingerprint  String?
  createdAt          DateTime @default(now())

  candidate          AtsCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
  @@index([candidateId, stepNumber])
  @@index([documentKey])
}

enum CaseOpeningStatus {
  OPEN
  FILLED
  CLOSED
}

enum CaseApplicationStatus {
  APPLIED
  MESSAGING
  MEET_SCHEDULED
  PARENT_PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// Case Coord posts openings; RBTs apply via HRM job board (de-identified fields for HRM).
model CaseOpening {
  id                   String            @id @default(uuid()) @db.Uuid
  clientId             String            @db.Uuid
  createdById          String            @db.Uuid
  caseCode             String            @unique
  status               CaseOpeningStatus @default(OPEN)
  weeklyHours          Int?
  borough              String?
  neighborhood         String?
  zipCode              String?
  childAge             Int?
  ageBand              String?
  clientInitials       String?
  scheduleText         String?
  locationNotes        String?
  transportationNotes  String?
  languagePref         String?
  genderPref           String?
  serviceSetting       String?           @default("In-home ABA (97153)")
  sessionLengthMinutes Int?
  daysOfWeek           String?
  listingHighlights    String?
  scheduleJson         Json?
  bcbaDisplayName      String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  client               Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy            User              @relation("CaseOpeningCreator", fields: [createdById], references: [id])
  applications         CaseApplication[]

  @@index([status])
  @@index([clientId])
  @@index([createdById])
}

model CaseApplication {
  id                String                @id @default(uuid()) @db.Uuid
  openingId         String                @db.Uuid
  rbtUserId         String                @db.Uuid
  status            CaseApplicationStatus @default(APPLIED)
  message           String?
  meetAt            DateTime?
  meetLink          String?
  parentDecisionAt  DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  opening           CaseOpening           @relation(fields: [openingId], references: [id], onDelete: Cascade)
  rbt               User                  @relation("CaseApplicationRbt", fields: [rbtUserId], references: [id])

  @@unique([openingId, rbtUserId])
  @@index([rbtUserId])
  @@index([status])
  @@index([openingId])
}

// ------------------------------------------------------
// MULTI-STATE RULE OWNERSHIP & DURABLE RESOLUTION
// ------------------------------------------------------

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  clients             Client[]
  sessions            Session[]
  serviceLocations    ServiceLocation[]
  payerPlans           PayerPlan[]
  providerEnrollments ProviderEnrollment[]
  ruleSets             RuleSet[]
}

model ServiceLocation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  code           String
  name           String
  timezone       String
  addressLine1   String?
  addressLine2   String?
  city           String?
  stateCode      String?
  postalCode     String?
  isActive       Boolean   @default(true)
  activeFrom     DateTime?
  activeTo       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization        Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  primaryForClients   Client[]
  sessions            Session[]
  jurisdictionLinks   ServiceLocationJurisdiction[]
  providerEnrollments ProviderEnrollment[]
  ruleSets             RuleSet[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model Jurisdiction {
  id        String            @id @default(uuid()) @db.Uuid
  code      String            @unique
  name      String
  level     JurisdictionLevel
  parentId  String?           @db.Uuid
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  parent        Jurisdiction?                  @relation("JurisdictionTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Jurisdiction[]                 @relation("JurisdictionTree")
  locationLinks ServiceLocationJurisdiction[]
  payerPlans    PayerPlan[]
  ruleSets      RuleSet[]

  @@index([parentId])
  @@index([level])
}

model ServiceLocationJurisdiction {
  serviceLocationId String @db.Uuid
  jurisdictionId    String @db.Uuid

  serviceLocation ServiceLocation @relation(fields: [serviceLocationId], references: [id], onDelete: Cascade)
  jurisdiction    Jurisdiction    @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)

  @@id([serviceLocationId, jurisdictionId])
  @@index([jurisdictionId])
}

model PayerPlan {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  jurisdictionId String?   @db.Uuid
  code           String
  name           String
  payerCode      String?
  programCode    String?
  isActive       Boolean   @default(true)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jurisdiction        Jurisdiction?         @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  providerEnrollments ProviderEnrollment[]
  ruleSets             RuleSet[]

  @@unique([organizationId, code])
  @@index([jurisdictionId])
  @@index([organizationId, isActive])
}

model ProviderEnrollment {
  id                 String                   @id @default(uuid()) @db.Uuid
  organizationId     String                   @db.Uuid
  payerPlanId        String                   @db.Uuid
  serviceLocationId  String?                  @db.Uuid
  providerUserId     String?                  @db.Uuid
  enrollmentType     String
  providerIdentifier String?
  status             ProviderEnrollmentStatus @default(PENDING)
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payerPlan        PayerPlan        @relation(fields: [payerPlanId], references: [id], onDelete: Restrict)
  serviceLocation ServiceLocation? @relation(fields: [serviceLocationId], references: [id], onDelete: Restrict)
  provider        User?            @relation(fields: [providerUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([payerPlanId, status])
  @@index([serviceLocationId])
  @@index([providerUserId])
}

model RuleSet {
  id                String            @id @default(uuid()) @db.Uuid
  key               String
  category          RuleCategory
  authorityKind     RuleAuthorityKind
  organizationId    String?           @db.Uuid
  serviceLocationId String?           @db.Uuid
  jurisdictionId    String?           @db.Uuid
  payerPlanId       String?           @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceLocation ServiceLocation? @relation(fields: [serviceLocationId], references: [id], onDelete: Restrict)
  jurisdiction    Jurisdiction?    @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  payerPlan       PayerPlan?       @relation(fields: [payerPlanId], references: [id], onDelete: Restrict)
  versions        RuleVersion[]

  @@index([key, category])
  @@index([organizationId])
  @@index([serviceLocationId])
  @@index([jurisdictionId])
  @@index([payerPlanId])
}

model RuleVersion {
  id            String              @id @default(uuid()) @db.Uuid
  ruleSetId     String              @db.Uuid
  version       Int
  status        RuleLifecycleStatus @default(DRAFT)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  payload       Json
  sourceRefs    Json                @default("[]")
  contentHash   String
  approvedById  String?             @db.Uuid
  approvedAt    DateTime?
  createdAt     DateTime            @default(now())

  ruleSet    RuleSet                        @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  approvedBy User?                          @relation("RuleVersionApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  selections ResolvedRuleVersionSelection[]

  @@unique([ruleSetId, version])
  @@unique([ruleSetId, contentHash])
  @@index([ruleSetId, status, effectiveFrom, effectiveTo])
  @@index([approvedById])
}

model ResolvedRuleSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  sessionId        String   @db.Uuid
  decisionKey      String
  evaluatorVersion String
  resolvedFacts    Json
  contentHash      String
  supersedesId     String?  @db.Uuid
  createdAt        DateTime @default(now())

  session      Session                        @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  supersedes   ResolvedRuleSnapshot?          @relation("RuleSnapshotHistory", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy ResolvedRuleSnapshot[]         @relation("RuleSnapshotHistory")
  selections   ResolvedRuleVersionSelection[]

  @@unique([sessionId, decisionKey, contentHash])
  @@index([sessionId, decisionKey, createdAt])
  @@index([supersedesId])
}

model ResolvedRuleVersionSelection {
  snapshotId    String @db.Uuid
  ruleVersionId String @db.Uuid
  precedence    Int

  snapshot    ResolvedRuleSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  ruleVersion RuleVersion          @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)

  @@id([snapshotId, ruleVersionId])
  @@unique([snapshotId, precedence])
  @@index([ruleVersionId])
}
