// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Role {
  CEO
  CLINICAL_DIRECTOR
  OPS_DIRECTOR
  INTAKE_PA_COORDINATOR
  CASE_COORDINATOR
  CLINICAL_SUPPORT
  BILLING
  BCBA
  RBT
  HR
  HEAD_HR
  HR_AGENT
  FINANCE
}

enum ClientStatus {
  INQUIRY
  MAGIC_LINK_SENT
  DOCS_SUBMITTED
  DOCS_APPROVED_INTAKE
  CLINICAL_REVIEW_APPROVED
  VOB_COMPLETED
  PA_SUBMITTED
  PA_APPROVED
  ASSESSMENT_SCHEDULED
  REPORT_ASSEMBLED
  TX_PA_SUBMITTED
  TX_PA_APPROVED
  STAFFING_PENDING
  ACTIVE
  DISCHARGED
}

enum IntakePacketStatus {
  PENDING_CLIENT_SUBMISSION
  SUBMITTED
  REJECTED_BY_INTAKE
  REJECTED_BY_CLINICAL
  APPROVED
}

enum PARequestStatus {
  NOT_STARTED
  SUBMITTED
  DENIED_CLERICAL
  DENIED_CLINICAL
  APPROVED
}

enum DocumentType {
  REFERRAL
  DIAGNOSTIC_EVAL
  PSYCH_EVAL
  IEP
  INSURANCE_CARD
  MEDICAID_CARD
  CONSENT
  CUSTODY
  PRIOR_TREATMENT_PLAN
  MEET_AND_GREET_FORM
  OTHER
}

enum AuthType {
  ASSESSMENT
  TREATMENT
}

enum AuthStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ContactMethod {
  PHONE
  EMAIL
  IN_PERSON
  VIDEO
  PORTAL
}

enum DeficiencyStatus {
  OPEN
  RESOLVED
}

// ------------------------------------------------------
// MODELS
// ------------------------------------------------------

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  firstName String
  lastName  String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  assignedCases          Client[]         @relation("CaseCoordinator")
  supportedClients       Client[]         @relation("ClinicalSupport")
  supervisedClients      Client[]         @relation("BCBASupervisor")
  clientsAsRbt           Client[]         @relation("RBT")
  sessionsAsRbt          Session[]        @relation("RbtSession")
  sessionsAsBcba         Session[]        @relation("BcbaSession")
  assignedActionItems    ActionItem[]     @relation("Assignee")
  createdActionItems     ActionItem[]     @relation("Creator")
  contactLogs            ContactLog[]
  rbtOnboardings         RbtOnboarding[]
  deficienciesToFix      NoteDeficiency[] @relation("DeficiencyAuthor")
  deficienciesFlagged    NoteDeficiency[] @relation("DeficiencyFlagger")
  sentMessages           StaffMessage[]   @relation("StaffMessageSender")
  receivedMessages       StaffMessage[]   @relation("StaffMessageReceiver")
  notifications          Notification[]
  credentials            StaffCredential[]
  evvLogs                EVVLog[]
}

model Client {
  id              String       @id @default(uuid()) @db.Uuid
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  childGender     String?
  childAge        Int?
  
  insurancePayer  String?
  memberId        String?
  medicaidId      String?
  status          ClientStatus @default(INQUIRY)
  
  // Contacts
  guardianName    String?
  parentGender    String?
  parentAddress   String?
  guardianPhone   String?
  guardianEmail   String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Clinical & Ops Team
  caseCoordinatorId String?    @db.Uuid
  clinicalSupportId String?    @db.Uuid
  bcbaId            String?    @db.Uuid
  rbtId             String?    @db.Uuid
  rbtApproved       Boolean    @default(false)
  
  caseCoordinator   User?      @relation("CaseCoordinator", fields: [caseCoordinatorId], references: [id])
  clinicalSupport   User?      @relation("ClinicalSupport", fields: [clinicalSupportId], references: [id])
  bcba              User?      @relation("BCBASupervisor", fields: [bcbaId], references: [id])
  rbt               User?      @relation("RBT", fields: [rbtId], references: [id])

  // Relations
  documents       Document[]
  authorizations  Authorization[]
  sessions        Session[]
  contactLogs     ContactLog[]
  rbtOnboarding   RbtOnboarding?
  
  intakePacket    IntakePacket?
  paRequests      PARequest[]
  messages        ClientMessage[]
  actionItems     ActionItem[]
  treatmentPlan   Json?        @default("{}")

  skillTargets    SkillTarget[]
  behaviorTargets BehaviorTarget[]
  appointments    ScheduleAppointment[]
  reAuthPackets   ReAuthPacket[]
}

model Document {
  id             String       @id @default(uuid()) @db.Uuid
  clientId       String       @db.Uuid
  type           DocumentType
  fileUrl        String?
  expirationDate DateTime?
  isVerified     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Authorization {
  id             String       @id @default(uuid()) @db.Uuid
  clientId       String       @db.Uuid
  type           AuthType
  status         AuthStatus   @default(PENDING)
  authNumber     String?
  startDate      DateTime?
  endDate        DateTime?
  unitsRequested Int?
  unitsApproved  Int?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  cptCodes       AuthCptCode[]
}

model AuthCptCode {
  id              String        @id @default(uuid()) @db.Uuid
  authorizationId String        @db.Uuid
  code            String        // e.g. 97151, 97153
  unitsApproved   Int?

  authorization   Authorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
}

model Session {
  id              String        @id @default(uuid()) @db.Uuid
  clientId        String        @db.Uuid
  rbtId           String?       @db.Uuid
  bcbaId          String?       @db.Uuid
  
  status          SessionStatus @default(SCHEDULED)
  scheduledStart  DateTime
  scheduledEnd    DateTime
  actualStart     DateTime?
  actualEnd       DateTime?
  
  cptCode         String?       // e.g. 97153
  location        String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  rbt             User?         @relation("RbtSession", fields: [rbtId], references: [id])
  bcba            User?         @relation("BcbaSession", fields: [bcbaId], references: [id])
  note            SessionNote?
  trialLogs       SessionTrialData[]
  behaviorLogs    BehaviorLog[]
}

model SessionNote {
  id              String    @id @default(uuid()) @db.Uuid
  sessionId       String    @unique @db.Uuid
  
  rbtSigned       Boolean   @default(false)
  parentSigned    Boolean   @default(false)
  bcbaSigned      Boolean   @default(false)
  
  clinicalContent String?   @db.Text
  isConverted     Boolean   @default(false) // Billable status

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  session         Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  deficiencies    NoteDeficiency[]
}

model ActionItem {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String?      @db.Text
  status      ActionStatus @default(OPEN)
  dueDate     DateTime?

  assigneeId  String?      @db.Uuid
  creatorId   String?      @db.Uuid
  clientId    String?      @db.Uuid

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assignee    User?        @relation("Assignee", fields: [assigneeId], references: [id])
  creator     User?        @relation("Creator", fields: [creatorId], references: [id])
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ContactLog {
  id          String        @id @default(uuid()) @db.Uuid
  clientId    String        @db.Uuid
  authorId    String        @db.Uuid
  method      ContactMethod
  subject     String
  outcome     String        @db.Text
  nextStep    String?       @db.Text
  
  createdAt   DateTime      @default(now())

  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author      User          @relation(fields: [authorId], references: [id])
}

model RbtOnboarding {
  id                  String   @id @default(uuid()) @db.Uuid
  clientId            String   @unique @db.Uuid
  rbtId               String   @db.Uuid

  bacbVerified        Boolean  @default(false)
  backgroundCleared   Boolean  @default(false)
  trainingsComplete   Boolean  @default(false)
  artemisAccountSetup Boolean  @default(false)
  payrollComplete     Boolean  @default(false)
  payerCredentialed   Boolean  @default(false)
  planOrientationDate DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  rbt                 User     @relation(fields: [rbtId], references: [id])
}

model NoteDeficiency {
  id          String           @id @default(uuid()) @db.Uuid
  noteId      String           @db.Uuid
  authorId    String           @db.Uuid
  flaggedById String           @db.Uuid
  
  description String           @db.Text
  status      DeficiencyStatus @default(OPEN)

  createdAt   DateTime         @default(now())
  resolvedAt  DateTime?

  note        SessionNote      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author      User             @relation("DeficiencyAuthor", fields: [authorId], references: [id])
  flaggedBy   User             @relation("DeficiencyFlagger", fields: [flaggedById], references: [id])
}

model IntakePacket {
  id              String             @id @default(uuid()) @db.Uuid
  clientId        String             @unique @db.Uuid
  magicLinkToken  String?            @unique
  deviceFingerprint String?
  status          IntakePacketStatus @default(PENDING_CLIENT_SUBMISSION)
  
  // Form checks
  intakeFormComplete      Boolean @default(false)
  consentFormComplete     Boolean @default(false)
  
  // JSON blob for continuous scrolling form
  formData                Json?   @default("{}")
  
  // Document uploads
  insuranceCardFrontUploaded Boolean @default(false)
  insuranceCardBackUploaded  Boolean @default(false)
  medicaidCardFrontUploaded  Boolean @default(false)
  medicaidCardBackUploaded   Boolean @default(false)
  diagnosticEvalUploaded  Boolean @default(false)
  physicianRxUploaded     Boolean @default(false)
  iepUploaded             Boolean @default(false)
  custodyDocsUploaded     Boolean @default(false)
  priorAbaRecordsUploaded Boolean @default(false)

  rejectionNotes  String? @db.Text
  rejectionDetails Json?  @default("{}")

  // Client requests
  clientChangeRequested Boolean @default(false)
  clientChangeNotes     String? @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model PARequest {
  id                    String          @id @default(uuid()) @db.Uuid
  clientId              String          @db.Uuid
  type                  AuthType
  status                PARequestStatus @default(NOT_STARTED)
  
  vobCompleted          Boolean @default(false)
  providerCredentialed  Boolean @default(false)

  // Final Auth Info
  authNumber            String?
  approvedUnits         Int?
  effectiveDate         DateTime?
  expirationDate        DateTime?
  
  p2pResolved           Boolean  @default(false)
  p2pNotes              String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  client                Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientMessage {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @db.Uuid
  content     String   @db.Text
  isFromClient Boolean @default(false)
  senderName  String
  createdAt   DateTime @default(now())
  readAt      DateTime?

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model StaffMessage {
  id          String   @id @default(uuid()) @db.Uuid
  senderId    String   @db.Uuid
  receiverId  String   @db.Uuid
  content     String   @db.Text
  createdAt   DateTime @default(now())
  readAt      DateTime?

  sender      User     @relation("StaffMessageSender", fields: [senderId], references: [id])
  receiver    User     @relation("StaffMessageReceiver", fields: [receiverId], references: [id])
}

model GoalTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   // "SKILL", "BRP", "PARENT"
  
  // Skill & Parent Fields
  domain      String?
  description String?
  mastery     String?

  // BRP Specific Fields
  behavior    String?
  topography  String?
  function    String?
  antecedent  String?
  consequence String?

  authorName  String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  title     String
  message   String   @db.Text
  type      String   @default("INFO") // INFO, WARNING, ALERT
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// IN-HOUSE EMR & DATA COLLECTION MODELS (MOTIVITY REPLACEMENT)
// ------------------------------------------------------

model SkillTarget {
  id              String   @id @default(uuid()) @db.Uuid
  clientId        String   @db.Uuid
  domain          String   // e.g. "Language", "Social", "Self-Help"
  title           String
  description     String?  @db.Text
  measurementType String   @default("TRIAL") // TRIAL, FREQUENCY, DURATION, TASK_ANALYSIS, INTERVAL
  targetStatus    String   @default("BASELINE") // BASELINE, IN_PROGRESS, MASTERED, ON_HOLD
  masteryCriteria String?  @default("80% over 3 sessions")
  baselineData    Float?
  phaseLines      Json?    @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trialLogs       SessionTrialData[]
}

model SessionTrialData {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @db.Uuid
  targetId    String   @db.Uuid
  score       String   // "+", "-", "P", "NR", or numeric duration/count
  promptLevel String?  // Independent, Verbal, Gestural, Model, Partial Physical, Full Physical
  trialIndex  Int      @default(1)
  timestamp   DateTime @default(now())

  session     Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  target      SkillTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
}

model BehaviorTarget {
  id                  String   @id @default(uuid()) @db.Uuid
  clientId            String   @db.Uuid
  behaviorName        String
  definition          String   @db.Text
  measurementType     String   @default("FREQUENCY") // FREQUENCY, DURATION, RATE
  antecedents         String?  @db.Text
  consequences        String?  @db.Text
  replacementBehavior String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client              Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  behaviorLogs        BehaviorLog[]
}

model BehaviorLog {
  id             String         @id @default(uuid()) @db.Uuid
  sessionId      String         @db.Uuid
  behaviorId     String         @db.Uuid
  frequencyCount Int?           @default(1)
  durationSeconds Int?          @default(0)
  intensity      String?        @default("MODERATE") // MILD, MODERATE, SEVERE
  abcNotes       String?        @db.Text
  timestamp      DateTime       @default(now())

  session        Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  behavior       BehaviorTarget @relation(fields: [behaviorId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// IN-HOUSE HRM & EVV MODELS (ARTEMIS HRM REPLACEMENT)
// ------------------------------------------------------

model StaffCredential {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  credentialType   String    // e.g. "NPI", "CAQH", "BACB_LICENSE", "CPR_CERT", "MEDICAID_PROVIDER_ID"
  credentialNumber String?
  payerName        String?   @default("ALL_PAYERS") // e.g. "Sunshine Health", "Simply Healthcare", "ALL_PAYERS"
  isCredentialed   Boolean   @default(true)
  expirationDate   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EVVLog {
  id                 String    @id @default(uuid()) @db.Uuid
  sessionId          String    @db.Uuid
  staffId            String    @db.Uuid
  clockInLat         Float?
  clockInLng         Float?
  clockOutLat        Float?
  clockOutLng        Float?
  isLocationVerified Boolean   @default(true)
  clockInTimestamp   DateTime  @default(now())
  clockOutTimestamp  DateTime?

  session            Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staff              User      @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// INTELLIGENT SCHEDULING MODELS (PHASE 5)
// ------------------------------------------------------

model ScheduleAppointment {
  id             String   @id @default(uuid()) @db.Uuid
  clientId       String   @db.Uuid
  rbtId          String?  @db.Uuid
  bcbaId         String?  @db.Uuid
  scheduledStart DateTime
  scheduledEnd   DateTime
  serviceAddress String?
  cptCode        String   @default("97153")
  status         String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, NO_SHOW
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// RE-AUTH & AUDIT VAULT MODELS (PHASES 9 & 11)
// ------------------------------------------------------

model ReAuthPacket {
  id                   String   @id @default(uuid()) @db.Uuid
  clientId             String   @db.Uuid
  paRequestId          String?  @db.Uuid
  status               String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, DENIED
  skillGraphSummary    Json?    @default("{}")
  behaviorGraphSummary Json?    @default("{}")
  attendancePct        Float    @default(95.0)
  cptRequestPayload    Json?    @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  client               Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model AuditLogVault {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  action       String   // VIEW, EDIT, SIGN, EXPORT, DELETE
  resourceType String   // CLIENT, SESSION_NOTE, PA_REQUEST, BILLING_CLAIM
  resourceId   String
  ipAddress    String?
  metadata     Json?    @default("{}")
  timestamp    DateTime @default(now())
}

// ------------------------------------------------------
// ATS RECRUITING & ONBOARDING MODELS (PHASE 13)
// ------------------------------------------------------

model AtsCandidate {
  id           String   @id @default(uuid()) @db.Uuid
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  appliedRole  String   @default("RBT") // RBT, BCBA, CLINICAL_DIRECTOR
  stage        String   @default("APPLIED") // APPLIED, INTERVIEW_SCHEDULED, OFFER_EXTENDED, BACKGROUND_CLEARANCE, ONBOARDING, ACTIVE_STAFF
  bacbNumber   String?
  bacbVerified Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  onboardingPacket CandidateOnboardingPacket?
}

model CandidateOnboardingPacket {
  id                    String   @id @default(uuid()) @db.Uuid
  candidateId           String   @unique @db.Uuid
  magicLinkToken        String?  @unique
  w4Complete            Boolean  @default(false)
  i9Complete            Boolean  @default(false)
  directDepositComplete Boolean  @default(false)
  cprUploaded           Boolean  @default(false)
  formData              Json?    @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  candidate             AtsCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}





